# The Briefing - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# Gemini API Key (get one at https://ai.google.dev/)
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# OPTIONAL - R2/S3 Storage (for production deployment)
# =============================================================================

# Cloudflare R2 or S3-compatible storage credentials
# Only needed if you're deploying in production and storing briefings in cloud storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# =============================================================================
# OPTIONAL - Web Search (for fact verification)
# =============================================================================

# Tavily API Key (for web search verification in Analyst and Editor agents)
# Get one at https://tavily.com/
TAVILY_API_KEY=

# =============================================================================
# PIPELINE CONFIGURATION
# =============================================================================

# Mode: "test" (faster models) or "production" (premium models)
BRIEFING_MODE=test

# Target total word count for the entire briefing
# BRIEFING_TOTAL_WORDS=2000

# Style preset for prose generation
# Options: "economist" (The Economist), "stratfor" (Stratfor), "mixed" (both - default)
# BRIEFING_STYLE_PRESET=mixed

# =============================================================================
# ADVANCED - Model Selection (optional overrides)
# =============================================================================

# Override specific agent models (defaults: test mode = gemini-3-flash-preview, production = gemini-3-pro-preview)
# BRIEFING_EDITOR_MODEL=gemini-3-pro-preview
# BRIEFING_ARCHITECT_MODEL=gemini-3-pro-preview
# BRIEFING_ANALYST_MODEL=gemini-3-pro-preview
# BRIEFING_STRUCTURE_MODEL=gemini-3-pro-preview
# BRIEFING_WRITER_MODEL=gemini-3-pro-preview
# BRIEFING_STYLIST_MODEL=gemini-3-pro-preview
# BRIEFING_CRITIC_MODEL=gemini-3-pro-preview
# BRIEFING_THEME_MODEL=gemini-3-pro-preview
# BRIEFING_EMBEDDING_MODEL=text-embedding-004
# BRIEFING_IMAGE_MODEL=gemini-2.5-flash-image

# =============================================================================
# ADVANCED - Editorial Thresholds
# =============================================================================

# Editorial quality thresholds
# BRIEFING_CRITIC_PASS_THRESHOLD=70
# BRIEFING_MAX_RETRY_ATTEMPTS=5
# BRIEFING_MAX_CRITIC_LOOPS=10
# BRIEFING_MAX_CONCURRENT_ANALYSTS=5

# =============================================================================
# ADVANCED - Clustering Parameters
# =============================================================================

# HDBSCAN clustering settings
# BRIEFING_HDBSCAN_MIN_CLUSTER_SIZE=3
# BRIEFING_HDBSCAN_MIN_SAMPLES=2
# BRIEFING_BLACK_SWAN_THRESHOLD=8
# BRIEFING_MIN_REGION_EVENTS=3

# Embedding settings
# BRIEFING_EMBEDDING_BATCH_SIZE=100
# BRIEFING_EMBEDDING_DIMENSIONS=768

# Storyline extraction
# BRIEFING_MAX_STORYLINES_PER_REGION=5
# BRIEFING_MAX_EVENTS_PER_STORYLINE=10
# BRIEFING_MAX_FEATURED_CANDIDATES=10

# =============================================================================
# ADVANCED - LLM Generation Parameters
# =============================================================================

# NOTE: All parameters below default to None (use model's default behavior)
# Only set these if you want to override the model defaults
# 
# IMPORTANT - Temperature for Gemini 3:
# - Default is 1.0 (recommended - do NOT change unless necessary)
# - Gemini 3's reasoning is optimized for temp=1.0
# - Lower values may cause looping or degraded performance
# - Range: 0.0-2.0

# Temperature Settings (0.0 = deterministic, 1.0 = balanced, 2.0 = creative)
# BRIEFING_THEME_TEMPERATURE=0.5
# BRIEFING_EDITOR_TEMPERATURE=0.5
# BRIEFING_ARCHITECT_TEMPERATURE=0.3
# BRIEFING_ANALYST_TEMPERATURE=0.7
# BRIEFING_STRUCTURE_TEMPERATURE=0.5
# BRIEFING_WRITER_TEMPERATURE=0.7
# BRIEFING_STYLIST_TEMPERATURE=0.6
# BRIEFING_CRITIC_TEMPERATURE=0.7
# BRIEFING_CRITIC_DEVILS_ADVOCATE_TEMPERATURE=0.9
# BRIEFING_IMAGE_TEMPERATURE=0.8

# Max Output Tokens (leave unset to let model decide when to stop naturally)
# BRIEFING_THEME_MAX_TOKENS=1000
# BRIEFING_EDITOR_MAX_TOKENS=24000
# BRIEFING_ARCHITECT_MAX_TOKENS=16000
# BRIEFING_ANALYST_MAX_TOKENS=8000
# BRIEFING_STRUCTURE_MAX_TOKENS=4000
# BRIEFING_WRITER_MAX_TOKENS=8000
# BRIEFING_WRITER_COD_MAX_TOKENS=    # Optional: limit Chain of Density output tokens
# BRIEFING_STYLIST_MAX_TOKENS=8000
# BRIEFING_CRITIC_MAX_TOKENS=4000
# BRIEFING_CRITIC_DEVILS_ADVOCATE_MAX_TOKENS=1500
# BRIEFING_IMAGE_MAX_TOKENS=500

# Thinking Levels (controls depth of model reasoning - leave unset for model default "high")
# Valid for Pro & Flash: "low" (fast, minimal reasoning), "high" (deep reasoning, default)
# Valid for Flash only: "minimal" (no thinking), "medium" (balanced)
# NOTE: Cannot mix thinking_level with legacy thinking_budget
# BRIEFING_EDITOR_THINKING=high
# BRIEFING_ARCHITECT_THINKING=high
# BRIEFING_ARCHITECT_FORMATTER_THINKING=minimal
# BRIEFING_ANALYST_THINKING=high
# BRIEFING_WRITER_THINKING=high
# BRIEFING_WRITER_COD_THINKING=      # Optional: thinking level for Chain of Density (OFF/minimal/high)

# Tool Usage
# BRIEFING_EDITOR_TOOL_ROUNDS=5
# BRIEFING_ANALYST_TOOL_ROUNDS=10

# =============================================================================
# ADVANCED - Retry & Timing
# =============================================================================

# BRIEFING_RETRY_INITIAL_DELAY=2.0
# BRIEFING_RETRY_MAX_DELAY=60.0

# =============================================================================
# ADVANCED - Cross-Regional Analysis
# =============================================================================

# BRIEFING_CROSS_REGIONAL_SIMILARITY=0.7

# =============================================================================
# ADVANCED - Image Generation
# =============================================================================

# BRIEFING_MAX_IMAGES=3

